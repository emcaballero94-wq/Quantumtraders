# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI (optional)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Market data
TWELVE_DATA_API_KEY=your_twelvedata_api_key
NEXT_PUBLIC_TWELVE_DATA_API_KEY=your_twelvedata_public_key
TRADING_ECONOMICS_KEY=your_trading_economics_key
TRADING_ECONOMICS_SECRET=your_trading_economics_secret
BINANCE_API_URL=https://api.binance.com

# OANDA (forex/metals/indices real-time data — free practice account works)
# Get a token at https://www.oanda.com/demo-account/tpa/personal_token
OANDA_API_TOKEN=your_oanda_personal_access_token
OANDA_ACCOUNT_ID=your_oanda_account_id
OANDA_ENVIRONMENT=practice

# Tradier (full options chain — sandbox token is free and instant at
# https://developer.tradier.com while your brokerage account is in review)
TRADIER_API_TOKEN=your_tradier_access_token
TRADIER_ENVIRONMENT=sandbox

# Crypto payments
CRYPTO_PAYMENT_PROVIDER=coinbase-commerce
COINBASE_COMMERCE_API_URL=https://api.commerce.coinbase.com
COINBASE_COMMERCE_API_KEY=your_coinbase_commerce_api_key
COINBASE_COMMERCE_WEBHOOK_SECRET=your_coinbase_webhook_secret

# MT5 Expert Advisor (Trade Journal bridge — see mql5/README.md)
MT5_JOURNAL_API_KEY=your_mt5_ea_shared_secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
